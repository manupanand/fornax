#
# fornax-gcp deploy agent (Pub/Sub pull -> git tag -> docker compose).
#
# Installed by the fornax-gcp package to /usr/lib/systemd/system/ and NOT enabled. The
# host-specific settings are added by `sudo fornax-gcp server init` in a drop-in:
#   /etc/systemd/system/fornax-gcp-agent.service.d/override.conf
#     [Service]
#     User=<deploy user, member of the docker group>
#     Environment=CLOUDSDK_CONFIG=<deploy.gcloud_config_dir>
# `server init` then runs `systemctl daemon-reload` and `systemctl enable --now`.
# Do not edit this file: package upgrades replace it. Put changes in the drop-in.

[Unit]
Description=fornax-gcp deploy agent (Pub/Sub pull -> git tag -> docker compose)
Documentation=file:/usr/share/doc/fornax-gcp/install.md
Wants=network-online.target
After=network-online.target docker.service
# Refuse to start before `server init` has installed the configuration.
ConditionPathExists=/etc/fornax-gcp/config.toml

[Service]
Type=simple
Environment=FORNAX_GCP_CONFIG=/etc/fornax-gcp/config.toml
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/fornax-gcp agent run
Restart=always
RestartSec=10
# On stop: SIGTERM only the agent, let a running deploy finish (up to 10 min) instead of
# killing docker mid-way.
KillMode=mixed
TimeoutStopSec=600
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
